PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local MongoDB Community Server:
MONGO_URI=mongodb://127.0.0.1:27017/stitchsmart
# MongoDB Atlas (Cloud Cluster):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/stitchsmart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
COOKIE_EXPIRES_DAYS=30

# Admin Seeding (for local development & initial setup)
ADMIN_NAME="StitchSmart Admin"
ADMIN_EMAIL=admin@stitchsmart.com
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_PHONE=+919876543210
